{
  "expo": {
    "owner": "shiftlogichq",
    "name": "PantryRun",
    "slug": "GroceryApp",
    "version": "1.30.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "groceryapp",
    "plugins": [
      "@sentry/react-native",
      [
        "react-native-libsodium",
        {}
      ],
      "./plugins/withLibcxxPickFirst.js",
      "./plugins/withCleartextTraffic.js",
      [
        "expo-notifications",
        {
          "color": "#10B981",
          "defaultChannel": "pantryrun-family"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.shiftlogichq.pantryrun",
      "buildNumber": "30",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:groceryapp.app"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.shiftlogichq.pantryrun"
        ],
        "com.apple.developer.siri": true
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Scan barcodes to add items to your grocery list, scan QR codes to join your family, and photograph store flyers for price extraction",
        "NSPhotoLibraryUsageDescription": "Select a store flyer photo from your library so PantryRun can read its prices",
        "NSMicrophoneUsageDescription": "Add items to your grocery list using voice commands",
        "NSSpeechRecognitionUsageDescription": "Convert voice commands to grocery list items",
        "ITSAppUsesNonExemptEncryption": true,
        "NSLocalNetworkUsageDescription": "PantryRun connects to your family's self-hosted relay server on your local network to sync grocery lists between devices.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["POST_NOTIFICATIONS"],
      "versionCode": 30,
      "_cleartextNote": "android:usesCleartextTraffic is applied by ./plugins/withCleartextTraffic.js. It is NOT an app.json key — Expo SDK 56 has no android.usesCleartextTraffic in its schema and no mod reads one, so a bare key here would be silently inert. Required for self-hosted relay WebSocket connections on a local network (ws:// without TLS).",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "groceryapp.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "groceryapp",
              "host": "invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "package": "com.shiftlogichq.pantryrun",
      "packagingOptions": {
        "pickFirst": ["**/libc++_shared.so"]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "65df9ed1-7d5e-4145-937f-7f27b405d669"
      }
    }
  }
}
