diff --git a/node_modules/react-native-libsodium/android/CMakeLists.txt b/node_modules/react-native-libsodium/android/CMakeLists.txt
index aea3c38..68e7833 100644
--- a/node_modules/react-native-libsodium/android/CMakeLists.txt
+++ b/node_modules/react-native-libsodium/android/CMakeLists.txt
@@ -31,9 +31,12 @@ set_target_properties( sodium PROPERTIES IMPORTED_LOCATION ${LIBSODIUM_BUILD_DIR
 
 # here we define a library target called "libsodium"
 # which will be built from the listed source files
+# NOTE: jsi.cpp is deliberately EXCLUDED. On RN 0.85+ with New Architecture,
+# Hermes already provides JSI symbols. Compiling a second copy into
+# liblibsodium.so causes vtable/symbol conflicts that SIGSEGV at runtime.
+# Instead, we link against ReactAndroid::jsi (prefab) for the symbols.
 add_library(libsodium
   SHARED
-  "${NODE_MODULES_DIR}/react-native/ReactCommon/jsi/jsi/jsi.cpp"
   ../cpp/react-native-libsodium.cpp
   ../cpp/react-native-libsodium.h
   cpp-adapter.cpp
@@ -42,5 +45,9 @@ add_library(libsodium
 # Enable Android 16kb native library alignment
 target_link_options(libsodium PRIVATE "-Wl,-z,max-page-size=16384")
 
+# Link against ReactAndroid's JSI prefab for facebook::jsi symbols
+find_package(ReactAndroid REQUIRED CONFIG)
+target_link_libraries(libsodium ReactAndroid::jsi)
+
 # link the sodium lib with our "libsodium" library target defined earlier
 target_link_libraries(libsodium sodium)
