+            // WARN  `new NativeEventEmitter()` was called with a non-null argument without the required `removeListeners` method.
+            NativeModulesProxy[moduleName].addListener = () => { };
+            NativeModulesProxy[moduleName].removeListeners = () => { };
+        }
+    });
