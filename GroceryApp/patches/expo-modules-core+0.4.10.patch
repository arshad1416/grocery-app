+          }
+        }
+
+        waitUntil { done in
+          ModuleHolder(module: module).call(method: methodName, args: [dict]) { value, error in
+            expect(value).notTo(beNil())
+            expect(value).to(beAKindOf(String.self))
+            expect(value).to(be(dict["property"]))
+            done()
+          }
+        }
